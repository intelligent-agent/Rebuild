#!/usr/bin/env python3
"""Record power-loss-probe's UDP lines with this machine's arrival times (Rebuild#140).

    power-loss-listen [--port 47123] > cut.log

Prints "<arrival seconds> <line>" per packet, flushed at once, so the file is
complete up to the last packet the board managed to send.
"""
import argparse, socket, sys, time
p = argparse.ArgumentParser()
p.add_argument("--port", type=int, default=47123)
a = p.parse_args()
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.bind(("0.0.0.0", a.port))
t0 = time.monotonic()
while True:
    data, _ = s.recvfrom(512)
    sys.stdout.write("%.4f %s" % (time.monotonic() - t0, data.decode(errors="replace")))
    sys.stdout.flush()
