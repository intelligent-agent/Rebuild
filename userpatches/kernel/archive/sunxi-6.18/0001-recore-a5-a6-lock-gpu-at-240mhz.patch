From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Elias Bakken <elias@iagent.no>
Date: Sat, 3 Oct 2026 00:00:00 +0200
Subject: [PATCH] arm64: dts: recore A5/A6 lock GPU at 240 MHz

The A5/A6 board DTS files are supplied by the kernel source. Remove the
Mali OPP link and assign the GPU core clock explicitly; assigned-clock-rates
alone does not identify a clock and leaves the GPU at its inherited rate.

Signed-off-by: Elias Bakken <elias@iagent.no>
---
 arch/arm64/boot/dts/allwinner/sun50i-a64-recore-a5.dts | 3 ++-
 arch/arm64/boot/dts/allwinner/sun50i-a64-recore-a6.dts | 3 ++-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-a64-recore-a5.dts b/arch/arm64/boot/dts/allwinner/sun50i-a64-recore-a5.dts
--- a/arch/arm64/boot/dts/allwinner/sun50i-a64-recore-a5.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-a64-recore-a5.dts
@@ -70,6 +70,7 @@
 };
 
 &mali {
 	/delete-property/ operating-points-v2;
-	assigned-clock-rates = <120000000>;
+	assigned-clocks = <&ccu CLK_GPU>;
+	assigned-clock-rates = <240000000>;
 };
diff --git a/arch/arm64/boot/dts/allwinner/sun50i-a64-recore-a6.dts b/arch/arm64/boot/dts/allwinner/sun50i-a64-recore-a6.dts
--- a/arch/arm64/boot/dts/allwinner/sun50i-a64-recore-a6.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-a64-recore-a6.dts
@@ -27,6 +27,7 @@
 };
 
 &mali {
 	/delete-property/ operating-points-v2;
-	assigned-clock-rates = <120000000>;
+	assigned-clocks = <&ccu CLK_GPU>;
+	assigned-clock-rates = <240000000>;
 };
