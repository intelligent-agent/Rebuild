#!/usr/bin/env python3
"""Generate native Moonraker sensors without changing Klipper configuration."""
import glob
import re
import sys
from pathlib import Path

MARKER = "# Generated by rebuild-klipper-sensors; do not edit.\n"
SENSORS = {
    "voltage": ("Board voltage", "V"),
    "current": ("Board current", "A"),
    "fan_current": ("Fan current", "A"),
    "remote_current": ("Toolhead current", "A"),
}


def discover(path, visited=None):
    visited = set() if visited is None else visited
    path = Path(path).resolve()
    if path in visited or not path.is_file():
        return {}
    visited.add(path)
    found = {}
    for line in path.read_text().splitlines():
        match = re.fullmatch(r"\s*\[([^]]+)\]\s*(?:[#;].*)?", line)
        if not match:
            continue
        section = match[1]
        if section.startswith("include "):
            for include in sorted(glob.glob(str(path.parent / section[8:].strip()))):
                found.update(discover(include, visited))
        elif section.startswith("temperature_sensor "):
            name = section[len("temperature_sensor "):].strip()
            key = name.removeprefix("_")
            if key in SENSORS:
                found[key] = name
    return found


def generate(config_dir):
    config_dir = Path(config_dir)
    target = config_dir / "rebuild-sensors.conf"
    if target.exists() and not target.read_text().startswith(MARKER):
        raise RuntimeError(f"Refusing to overwrite user-owned {target}")
    sections = [MARKER]
    for key, object_name in sorted(discover(config_dir / "printer.cfg").items()):
        title, units = SENSORS[key]
        sections.append(
            f"[sensor {key}]\ntype: klipper\nname: {title}\n"
            f"object: temperature_sensor {object_name}\n"
            f"parameter: {key}\nparameter_{key}:\n  units={units}\n"
        )
    target.write_text("\n".join(sections))


if __name__ == "__main__":
    generate(sys.argv[1])
