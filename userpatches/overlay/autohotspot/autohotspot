#!/bin/bash

. /etc/rebuild-settings
# Holds the plaintext wifi password - make sure it's root-only
# regardless of how/when it was last written.
chmod 600 /etc/rebuild-settings
wifidev=`nmcli dev | grep "wifi " | cut -d' ' -f1`

# No radio, nothing to do - and this has to be checked before anything else
# uses $wifidev. Empty means `nmcli con add type wifi ifname ""`, which lets
# NetworkManager choose a device for us, and it chooses lo:
#
#   Error: Connection activation failed: No suitable device found for this
#   connection (device lo not available because profile is not compatible
#   with device (connection type is not "loopback")).
#
# What that cost on an A5 with no dongle: the full CLIENT_TIMEOUT spent hunting
# for an SSID no radio could ever see, then a hotspot that could not be created
# either, then exit 4 and a failed unit on every boot. None of it is an error
# worth reporting - a board with only Ethernet is a supported configuration, so
# say so once and leave quietly, the way Reflash's wifi-bringup does.
if [ -z "$wifidev" ]; then
  echo "No wifi device present - skipping hotspot (board is usable over Ethernet)"
  exit 0
fi

hotspot_SSID="Recore"
hotspot_PW="12345678"
# How long to wait for the configured network at boot before falling back to the
# hotspot. Only boot-time availability matters here - if the connection later
# drops, we deliberately do not fall back.
#
# Two minutes, and then the board is an access point for the rest of this boot.
# That is the whole rule, on purpose: it can be explained to a user in one
# sentence, and it bounds how long they wait before something they can connect
# to appears. A periodic retry was considered and rejected (#80) - the radio
# cannot be an AP and a station at the same time, so every retry would take the
# hotspot away from whoever came to use it precisely because the network is
# down.
#
# 120s rather than the previous 60s because a single transient miss used to be
# permanent, and NetworkManager starts while a USB dongle behind a hub may still
# be enumerating.
CLIENT_TIMEOUT=120

create_hotspot() {
  echo "Creating hotspot"
  nmcli con add type wifi ifname "$wifidev" con-name Hotspot ssid "$hotspot_SSID"
  # Unbind from the interface it was created on (#90). See unbind_profiles.
  nmcli con modify Hotspot connection.interface-name ""
  nmcli con modify Hotspot 802-11-wireless.mode ap
  nmcli con modify Hotspot 802-11-wireless.band bg
  nmcli con modify Hotspot 802-11-wireless.channel 1
  nmcli con modify Hotspot ipv4.method shared
  nmcli con modify Hotspot ipv4.addresses 192.168.50.1/24
  # Brought up explicitly below, not left to NetworkManager's own
  # autoconnect arbitration - see the Client/Hotspot race in #65.
  nmcli con modify Hotspot connection.autoconnect no
  nmcli con modify Hotspot wifi-sec.key-mgmt wpa-psk
  nmcli con modify Hotspot wifi-sec.psk "$hotspot_PW"
}

create_client() {
  echo "Creating wifi client config"
  nmcli con add type wifi ifname "$wifidev" con-name Client ssid "$WIFI_SSID"
  # Unbind from the interface it was created on (#90). See unbind_profiles.
  nmcli con modify Client connection.interface-name ""
  nmcli con modify Client connection.autoconnect no
  nmcli con modify Client wifi-sec.key-mgmt wpa-psk
  nmcli con modify Client wifi-sec.psk "$WIFI_PSK"
}

# Let either profile run on whatever WiFi device is present (#90).
#
# `con add ... ifname "$wifidev"` sets connection.interface-name, and
# NetworkManager will then only activate that profile on an interface with
# exactly that name. USB dongles get MAC-derived names - the A6's is
# wlx90de8097db67 - so a different dongle is a different name and neither
# profile matches it any more. The board stops joining the configured SSID and
# falls back to the hotspot after the full CLIENT_TIMEOUT, with nothing in the
# output mentioning the dongle; it reads exactly like the network being out of
# range. If the Hotspot profile is pinned too, nothing comes up at all.
#
# Run on every boot, not just at creation: the guards below only create a
# profile when its file is absent, so a board that already has pinned profiles
# would keep them forever. Clearing an already-empty value is a no-op, so this
# is cheap and idempotent.
#
# A board has one WiFi radio, so there is nothing for the binding to
# disambiguate in the first place.
unbind_profiles() {
  local c
  for c in Hotspot Client; do
    [ -f "/etc/NetworkManager/system-connections/$c.nmconnection" ] || continue
    [ -n "$(nmcli -g connection.interface-name con show "$c" 2>/dev/null)" ] || continue
    echo "Unpinning $c from its original interface (#90)"
    nmcli con modify "$c" connection.interface-name "" || true
  done
}

if [ ! -f /etc/NetworkManager/system-connections/Hotspot.nmconnection ]; then
  create_hotspot
fi

if [ ! -f /etc/NetworkManager/system-connections/Client.nmconnection ]; then
  if [ -n "$WIFI_SSID" ]; then
    create_client
  else
    echo "No WIFI_SSID found in /etc/rebuild-settings. Skipping Client setup."
  fi
fi

unbind_profiles

# Decide which connection to bring up this boot. Both connections have
# autoconnect disabled, so NetworkManager never arbitrates between them
# itself - the choice is made explicitly, once, here.
if [ -n "$WIFI_SSID" ] && [ -f /etc/NetworkManager/system-connections/Client.nmconnection ]; then
  echo "Trying to connect to $WIFI_SSID for up to ${CLIENT_TIMEOUT}s..."
  # Retry against a wall-clock deadline instead of handing the whole budget to
  # one nmcli call. `nmcli -w` only bounds how long *nmcli* waits; NetworkManager
  # gives up on its own well before that. Measured on an A8: an SSID that is not
  # present fails with "The Wi-Fi network could not be found" after 27s, so
  # -w 120 spent 27s and fell back - the timeout was never the thing in control.
  #
  # Rescan before each attempt, because that failure is usually NM answering
  # from a stale scan cache: at boot the cache can predate the USB dongle
  # finishing enumeration, and one miss then used to be permanent (#80).
  #
  # Deliberately attempt every round rather than first checking the SSID appears
  # in the scan - a hidden network never appears, and skipping the attempt would
  # break it.
  deadline=$(( $(date +%s) + CLIENT_TIMEOUT ))
  connected=no
  while :; do
    nmcli dev wifi rescan >/dev/null 2>&1
    sleep 3
    if nmcli -w 20 con up Client; then
      connected=yes
      break
    fi
    [ "$(date +%s)" -ge "$deadline" ] && break
    echo "  ...still looking for $WIFI_SSID"
    sleep 5
  done

  if [ "$connected" = yes ]; then
    echo "Connected to $WIFI_SSID"
  else
    echo "Could not connect to $WIFI_SSID within ${CLIENT_TIMEOUT}s, falling back to hotspot"
    nmcli con down Client 2>/dev/null
    nmcli con up Hotspot
  fi
else
  echo "No WIFI_SSID configured, starting hotspot"
  nmcli con up Hotspot
fi
