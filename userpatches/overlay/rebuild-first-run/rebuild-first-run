#!/bin/bash

# This script is run only once, the first time Rebuild boots after being flashed

set -e

# pipefail so a `... | tee` reports the script's status and not tee's (#92).
#
# Without it the flash-rp2040 pipe below already swallowed failures - tolerated
# only because it exits 0 when no RP2040 is attached - and piping flash-stm32
# the same way would have quietly turned a failed STM32 flash into a successful
# first run, which is far worse than the loop it replaced.
set -o pipefail

. /etc/rebuild-settings

# Say so in the log that survives a reboot, not just the journal. An
# unrecoverable first run is now bounded by StartLimitBurst (see the unit), so
# without this the persistent log would simply stop mid-sentence and give no
# hint that anything had gone wrong at all.
report_failure() {
    rc=$?
    [ "$rc" -eq 0 ] && return 0
    log "--First run FAILED (exit $rc)-- see: journalctl -u rebuild-first-run"
    return 0
}
trap report_failure EXIT

log() {
    echo "$1" | tee -a /var/log.hdd/rebuild-first-run.log
}

echo "Starting rebuild first run script"
echo "--Beginning of first run script--" > /var/log.hdd/rebuild-first-run.log

# The A5's analogue frontend and stepper clock need Klipper extras that are
# neither used nor compatible with later boards. Klipper warns about these
# out-of-tree modules merely being present, which leaves every non-A5 board
# looking misconfigured. Do this only after a positive revision read: retaining
# the files is safer than breaking an A5 if its EEPROM cannot be read.
revision="$(/usr/local/bin/get-recore-revision 2>/dev/null || true)"
if [ -n "$revision" ] && [ "${revision,,}" != "a5" ]; then
    log "Removing A5-only Klipper files for ${revision}"
    rm -f \
        /home/printer/klipper/config/generic-recore-a5.cfg \
        /home/printer/klipper/klippy/extras/recore_adc_temperature.py \
        /home/printer/klipper/klippy/extras/recore_thermistor.py \
        /home/printer/klipper/klippy/extras/tmc2209_a5.py \
        /home/printer/klipper/klippy/extras/tmc2130_a5.py
else
    log "Keeping A5-only Klipper files (revision: ${revision:-unreadable})"
fi

log "Running flash-stm32 script"
# Captured, like flash-rp2040 below. This is the mandatory step and the one that
# actually failed in #92, yet its output went only to the journal - so the
# persistent log ended at "Running flash-stm32 script" and the reason was gone
# by the time anyone looked. Safe to pipe now that pipefail is set above.
/usr/local/bin/flash-stm32 2>&1 | tee -a /var/log.hdd/rebuild-first-run.log

# Any attached RP2040 (ReTool A2, Remote). Exits 0 when none is present, so a
# board without one is not a failed first boot - unlike flash-stm32, the target
# here is optional hardware.
log "Running flash-rp2040 script"
# Explicitly non-fatal, which pipefail would otherwise have changed.
#
# The RP2040 is optional hardware, and this script exits 1 on conditions that
# say nothing about the board's health - "something is already in the bootloader
# - refusing to guess which board it is" being the live one. Before pipefail,
# tee swallowed that status and first run carried on. With pipefail it would
# propagate, set -e would abort, and Restart=on-failure would retry to the burst
# limit - failing a perfectly good board over a peripheral. Keep the status
# visible in the log, but do not let it end the run.
/usr/local/bin/flash-rp2040 2>&1 | tee -a /var/log.hdd/rebuild-first-run.log \
    || log "flash-rp2040 exited non-zero (optional hardware) - continuing"

log "Disabling rebuild-first-run.service"
systemctl disable rebuild-first-run.service
