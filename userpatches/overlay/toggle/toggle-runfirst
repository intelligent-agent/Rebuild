#!/usr/bin/python3

import yaml
import secrets
import string
import os

def make_key(length):
    return ''.join(secrets.choice(string.ascii_letters + string.digits) for i in range(length))


def update_user_config(fname):
    """Add the `toggle` user OctoPrint's autologin resolves.

    No password and no API key. Toggle authenticates by accessControl.autologin
    - OctoPrint logs a local client in as this user - so nothing here ever has to
    match OctoPrint's password hashing.

    That used to be sha512(password + salt), which was OctoPrint's old format.
    1.11 stores argon2id, so the hash written here could not authenticate and the
    touchscreen waited forever on a board whose wizard had been completed. The
    user still has to EXIST, because autologinAs resolves through find_user(),
    but its password is deliberately unusable: a random value that no hashing
    scheme will ever verify, so password login for this account simply fails.
    """
    with open(fname, 'r') as f_in:
        users = yaml.safe_load(f_in) or {}
    users['toggle'] = {
        'active': True,
        'apikey': None,
        'groups': ['users'],
        'password': make_key(64),
        'permissions': [],
        'roles': ['user'],
        'settings': {}
    }
    with open(fname, 'w') as f_out:
        yaml.safe_dump(users, f_out, default_flow_style=False)


fname = '/home/printer/.octoprint/users.yaml'
MARKER = '/var/lib/toggle-runfirst.done'

# Runs once, when users.yaml exists. The waiting is systemd's job - see
# toggle-runfirst.path, which watches this path with inotify.
#
# This used to be a `while True: sleep(1)` here, which meant a resident Python
# process spending a wakeup a second for however long it takes somebody to
# finish OctoPrint's setup wizard - possibly never. The wait itself is not
# avoidable: OctoPrint decides the access-control wizard is needed by asking
# whether users.yaml exists at all, so creating the toggle user any earlier
# would satisfy that check and ship a printer whose owner is never asked to
# make an admin account.
if not os.path.exists(fname):
  print("no %s yet - toggle-runfirst.path should have waited for it" % fname)
  raise SystemExit(0)

update_user_config(fname)

# Leave a marker BEFORE touching the units, and stop the path unit as well as
# disabling it.
#
# PathExists= re-arms the moment the service deactivates, so a service that does
# not make the condition false gets restarted immediately, forever - it is meant
# for units that consume the path, like a spool directory. Measured here: 18
# invocations in the seconds it took to notice. `disable` alone does not help,
# it only affects the next boot, and systemd says so:
#
#   Disabling 'toggle-runfirst.service', but its triggering units are still
#   active: toggle-runfirst.path
#
# So: stop kills it for this boot, disable for the next, and the marker makes the
# service itself a no-op through ConditionPathExists= if either is ever missed.
open(MARKER, "w").close()
os.system("systemctl disable toggle-runfirst.path toggle-runfirst.service")
os.system("systemctl stop toggle-runfirst.path")
print("added the toggle user; autologin does the rest")
