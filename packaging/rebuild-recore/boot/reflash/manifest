# Reflash target manifest: how Reflash installs this image (Reflash
# docs/target-interface.md, Reflash#179). The installer named here does
# everything specific to Rebuild; Reflash only writes the image and runs it.
interface=1
root=2
boot=1
prepare=ext4-grow-root
installer=/usr/lib/reflash/target-installer
# Not /var/log.hdd: armbian-ramlog bind-mounts the disk's /var/log over that
# at boot, hiding whatever was written into the directory itself (#133).
# Written here it is /var/log.hdd/reflash.log on the running system, and
# copied into the RAM /var/log at every boot.
log=/var/log/reflash.log
settings=SSH_ENABLED,SCREEN_ROTATION,WIFI_SSID,WIFI_PSK,LOGIN_PASSWORD,ROOT_PASSWORD,WIFI_COUNTRY,TIMEZONE,WIFI_MODE,HOTSPOT_SSID,HOTSPOT_PSK,SOFTWARE
actions=settings,backup,restore,list,list-archive
