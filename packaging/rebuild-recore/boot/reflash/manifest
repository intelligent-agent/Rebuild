# Reflash target manifest: how Reflash installs this image (Reflash
# docs/target-interface.md, Reflash#179). The installer named here does
# everything specific to Rebuild; Reflash only writes the image and runs it.
interface=1
root=2
boot=1
prepare=ext4-grow-root
installer=/usr/lib/reflash/target-installer
log=/var/log.hdd/reflash.log
settings=SSH_ENABLED,SCREEN_ROTATION,WIFI_SSID,WIFI_PSK,LOGIN_PASSWORD
actions=settings,backup,restore
