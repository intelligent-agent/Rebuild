#!/bin/bash

set -e

# Under Reflash (target interface, Reflash#179) the revision is given: Reflash
# read it from this same partition before writing the image. Use that rather
# than loop-mounting the eMMC's boot partition from inside the installer's
# chroot, where udev and the loop devices belong to Reflash, not to us.
if [ -n "${REFLASH_INTERFACE:-}" ] && [ -n "${REFLASH_REVISION:-}" ]; then
    echo "$REFLASH_REVISION"
    exit 0
fi

. "${REBUILD_LIB:-/usr/lib/rebuild}/config-device"

# The config is mounted by offset, so there is no partition node to wait for:
# the first-boot race with udev (the old losetup -P and p1) cannot happen.
config_mount
trap config_umount EXIT

CONFIG=$(ls "$CONFIG_MNT"/*.json)
REVISION=$(grep Revision "$CONFIG" | cut -d '"' -f 4 | tr '[:upper:]' '[:lower:]')

echo "$REVISION"
