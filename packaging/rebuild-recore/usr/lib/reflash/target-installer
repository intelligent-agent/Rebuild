#!/bin/bash
# Rebuild's side of Reflash's target interface v1 (Reflash
# docs/target-interface.md, Reflash#179): how this image installs itself.
#
#   target-installer prepare      after Reflash has written the image
#   target-installer configure    with the user's choices on stdin
#   target-installer settings     print the current choices (no secrets)
#   target-installer backup       the user's files, as a gzip tar on stdout
#   target-installer restore      ...and back from stdin, onto a fresh install
#
# Any other action exits 3, "not supported", as the interface asks.
#
# Reflash runs this chrooted into the freshly written image, with /boot
# mounted, so it uses this image's own tools and knows this image's layout.
# Reflash itself knows none of it. That is the point: a Reflash flashed today
# can install a Rebuild made years from now.
#
# Packages add their own steps in target-installer.d/: each executable there
# runs after this script's own, with the same argument and environment, and
# with the settings on stdin for configure.
#
# Both actions may run more than once on the same board, and must end in the
# same state each time.
set -euo pipefail

# Everything is relative to $R: empty under Reflash, a scratch tree in the
# tests.
R="${REFLASH_TEST_ROOT:-}"
HOOKS="$R/usr/lib/reflash/target-installer.d"

die() {
    echo "ERROR: $*"
    exit 1
}

[ "${REFLASH_INTERFACE:-}" = 1 ] || die "Reflash speaks target interface '${REFLASH_INTERFACE:-}', this image needs 1"

run_hooks() {
    local hook
    for hook in "$HOOKS"/*; do
        [ -x "$hook" ] || continue
        echo "running ${hook##*/}"
        "$hook" "$@"
    done
}

prepare() {
    local rev=${REFLASH_REVISION:-} root_uuid boot_uuid env dtb
    [[ $rev =~ ^[a-z][0-9]+$ ]] || die "Reflash gave no usable hardware revision ('$rev')"
    [ -n "${REFLASH_BOOT_DEV:-}" ] || die "this image needs its boot partition mounted at /boot"

    root_uuid=$(blkid -s UUID -o value "$REFLASH_ROOT_DEV")
    boot_uuid=$(blkid -s UUID -o value "$REFLASH_BOOT_DEV")
    [ -n "$root_uuid" ] && [ -n "$boot_uuid" ] || die "could not read the partitions' UUIDs"

    # The UUIDs Reflash just gave the partitions, so the installed system
    # mounts its own and not the USB drive's, which can carry the same image.
    echo "fstab: root $root_uuid, boot $boot_uuid"
    sed -i "s:^UUID=[^ ]* / :UUID=$root_uuid / :" "$R/etc/fstab"
    sed -i "s:^UUID=[^ ]* /boot :UUID=$boot_uuid /boot :" "$R/etc/fstab"

    # Reflash has already grown the root filesystem; Armbian's first-boot
    # resize would only find nothing to do.
    touch "$R/root/.no_rootfs_resize"

    # New host keys for this board. The image ships keys baked into the build's
    # rootfs cache, and without this every board flashed from it would share
    # one key pair. Deleted first: ssh-keygen -A only creates keys that are
    # missing. And Armbian's own first-boot regeneration is off, since this has
    # done it - before first boot, so the first login can be checked.
    if [ -f "$R/etc/default/armbian-firstrun" ]; then
        sed -i 's/OPENSSHD_REGENERATE_HOST_KEYS=true/OPENSSHD_REGENERATE_HOST_KEYS=false/' "$R/etc/default/armbian-firstrun"
    fi
    rm -f "$R"/etc/ssh/ssh_host_*
    ssh-keygen -A ${R:+-f "$R"} > /dev/null
    echo "new SSH host keys"

    # The device tree for this revision, chosen before the first boot. Not a
    # warning when it is missing: the board would boot the generic tree, and an
    # A5/A6 would run its DDR3 under voltage (Reflash#138). Reflash's own boot
    # script reads this fdtfile= too, to set the DRAM rail on the next flash -
    # that is part of the interface (section 5).
    env="$R/boot/armbianEnv.txt"
    dtb="allwinner/sun50i-a64-recore-$rev.dtb"
    [ -f "$R/boot/dtb/$dtb" ] || die "this image has no device tree for Recore $rev (/boot/dtb/$dtb)"
    [ -f "$env" ] || die "this image has no /boot/armbianEnv.txt"
    sed -i -e '/^rootdev=/d' -e '/^fdtfile=/d' -e '/^$/d' "$env"
    printf 'rootdev=UUID=%s\nfdtfile=%s\n' "$root_uuid" "$dtb" >> "$env"
    # Boot scripts on Reflash sticks from before fdtfile= read this symlink
    # for the DRAM rail. It does not last on the board - the linux-dtb
    # package owns the name - which is why fdtfile= is what selects the tree.
    ln -sf "sun50i-a64-recore-$rev.dtb" "$R/boot/dtb/allwinner/sun50i-a64-recore.dtb"
    echo "device tree: $dtb"

    run_hooks prepare
}

# Settings, KEY=VALUE per line, the value literal to the end of the line.
# Unknown keys are ignored, as the interface requires.
declare -A S=()
read_settings() {
    local line
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line%$'\r'}
        [[ $line == *=* ]] || continue
        S[${line%%=*}]=${line#*=}
    done
    [ "${S[SETTINGS]:-}" = 1 ] || die "settings version '${S[SETTINGS]:-}' is not 1"
    case ${S[SCREEN_ROTATION]:-0} in 0 | 90 | 180 | 270) ;; *) die "screen rotation '${S[SCREEN_ROTATION]}' is not 0, 90, 180 or 270" ;; esac
    case ${S[SSH_ENABLED]:-false} in true | false) ;; *) die "SSH_ENABLED '${S[SSH_ENABLED]}' is not true or false" ;; esac
    return 0
}

# The account a person logs in with: debian on the printer images, root on
# barebone, which has no other user.
login_user() {
    if grep -q '^debian:' "$R/etc/passwd"; then echo debian; else echo root; fi
}

# The new login password, checked by this image's own rules before it is set
# (Reflash#182). Those are PAM's pam_unix "obscure" (common-password; there is
# no pwquality): for a new password with no old one to compare against, at
# least 6 characters and not a palindrome. chpasswd runs as root, and PAM does
# not check root's changes, so they are applied here.
set_password() {
    local pw=$1 user rev today
    user=$(login_user)
    [ "${#pw}" -ge 6 ] || die "the password is too short: at least 6 characters"
    rev=$(rev <<< "$pw")
    [ "$pw" != "$rev" ] || die "the password is a palindrome"
    printf '%s:%s\n' "$user" "$pw" | chpasswd ${R:+-R "$R"}
    # No forced change at first login: the user has just chosen this one.
    # chpasswd dates the change by the clock, and Reflash's can be unset in
    # hotspot mode; a change dated 1970 is what "must change now" means, so
    # never record one earlier than this image.
    today=$(date +%F)
    [[ $today > 2026-01-01 ]] || today=2026-01-01
    chage ${R:+-R "$R"} -d "$today" "$user"
    echo "login password set for $user"
}

# The screen, touch input and boot splash, turned by SCREEN_ROTATION degrees
# clockwise. Every place that draws is set, whichever this image uses, because
# a user can switch between them later.
rotate() {
    local deg=$1 xorg fbcon plymouth weston matrix env
    case $deg in
        0) xorg=normal fbcon=0 plymouth=normal weston=normal matrix="1 0 0 0 1 0 0 0 1" ;;
        90) xorg=right fbcon=1 plymouth=right_side_up weston=rotate-270 matrix="0 1 0 -1 0 1 0 0 1" ;;
        180) xorg=inverted fbcon=2 plymouth=upside_down weston=rotate-180 matrix="-1 0 1 0 -1 1 0 0 1" ;;
        270) xorg=left fbcon=3 plymouth=left_side_up weston=rotate-90 matrix="0 -1 1 1 0 0 0 0 1" ;;
    esac

    # Xorg names the output by the driver that owns it: HDMI-1 under sun4i-drm,
    # None-1 under simpledrm. A Monitor section naming no output is unused, so
    # both are written.
    if [ -d "$R/usr/share/X11/xorg.conf.d" ]; then
        cat > "$R/usr/share/X11/xorg.conf.d/90-monitor.conf" <<EOF
Section "Monitor"
    Identifier "HDMI-1"
    Option "Rotate" "$xorg"
EndSection
Section "Monitor"
    Identifier "None-1"
    Option "Rotate" "$xorg"
EndSection
Section "InputClass"
    Identifier "Coordinate Transformation Matrix"
    MatchIsTouchscreen "on"
    MatchDevicePath "/dev/input/event*"
    MatchDriver "libinput"
    Option "CalibrationMatrix" "$matrix"
EndSection
EOF
    fi

    if [ -f "$R/etc/xdg/weston/weston.ini" ]; then
        sed -i "s/^transform=.*/transform=$weston/" "$R/etc/xdg/weston/weston.ini"
    fi

    # The kernel console, and Plymouth, which ignores fbcon=rotate: and reads
    # the DRM panel orientation instead. Both connector names again: HDMI-A-1
    # under sun4i-drm, Unknown-1 under simpledrm, and the kernel ignores a
    # video= for a connector that does not exist. Earlier values are removed
    # first, so running this twice gives the same line.
    env="$R/boot/armbianEnv.txt"
    if [ -f "$env" ]; then
        grep -q '^extraargs=' "$env" || echo 'extraargs=' >> "$env"
        sed -i -E -e '/^extraargs=/ s/ *fbcon=rotate:[0-3]//g' \
            -e '/^extraargs=/ s/ *video=(HDMI-A-1|Unknown-1):panel_orientation=[a-z_]*//g' "$env"
        sed -i "/^extraargs=/ s|\$| fbcon=rotate:$fbcon video=HDMI-A-1:panel_orientation=$plymouth video=Unknown-1:panel_orientation=$plymouth|" "$env"
        sed -i 's/^extraargs= /extraargs=/' "$env"
    fi
    echo "screen rotation: $deg"
}

WIFI_CLIENT="$R/usr/lib/rebuild/wifi-client"

# Each choice lives where the system itself reads it - there is no settings
# file (#134): Wi-Fi in NetworkManager's Client profile, SSH in whether
# ssh.service is enabled, the rotation in armbianEnv.txt and the compositor's
# config. Reading them back is reading those.
ssh_enabled() {
    if systemctl ${R:+--root="$R"} is-enabled --quiet ssh.service 2>/dev/null; then echo true; else echo false; fi
}

current_rotation() {
    local n
    n=$(grep -o 'fbcon=rotate:[0-3]' "$R/boot/armbianEnv.txt" 2>/dev/null | head -1 | cut -d: -f2)
    echo $(( ${n:-0} * 90 ))
}

configure() {
    local stdin ssid psk
    stdin=$(mktemp)
    trap 'rm -f "$stdin"' RETURN
    cat > "$stdin"
    read_settings < "$stdin"

    # Only what was given changes; everything else stays as it is, so changing
    # one choice later - a forgotten password, from a Reflash booted to repair
    # it - does not reset the rest.
    if [ -n "${S[SCREEN_ROTATION]+set}" ]; then
        rotate "${S[SCREEN_ROTATION]}"
    fi

    if [ -n "${S[SSH_ENABLED]+set}" ]; then
        if [ "${S[SSH_ENABLED]}" = true ]; then
            systemctl ${R:+--root="$R"} enable ssh.service
        else
            systemctl ${R:+--root="$R"} disable ssh.service
        fi
        echo "SSH at boot: ${S[SSH_ENABLED]}"
    fi

    # Never echo the passphrase or the password: this output is Reflash's log.
    if [ -n "${S[WIFI_SSID]+set}" ] || [ -n "${S[WIFI_PSK]+set}" ]; then
        ssid=${S[WIFI_SSID]-$("$WIFI_CLIENT" ssid)}
        psk=${S[WIFI_PSK]-$("$WIFI_CLIENT" psk)}
        if [ -n "$ssid" ]; then
            printf '%s\n%s\n' "$ssid" "$psk" | "$WIFI_CLIENT" set
            echo "Wi-Fi network: '$ssid'"
        else
            "$WIFI_CLIENT" remove
            echo "Wi-Fi network: none, the board starts its hotspot"
        fi
    fi

    # From an older Reflash, or a board from before #134: not read by anything
    # any more, and it holds the passphrase in a second place.
    rm -f "$R/etc/rebuild-settings"

    if [ -n "${S[LOGIN_PASSWORD]:-}" ]; then
        set_password "${S[LOGIN_PASSWORD]}"
    fi

    run_hooks configure < "$stdin"
}

# For Reflash to show before the user changes anything. Secrets are never
# printed; whether one is set is not even hinted at.
settings() {
    printf 'SETTINGS=1\nSSH_ENABLED=%s\nSCREEN_ROTATION=%s\nWIFI_SSID=%s\n' \
        "$(ssh_enabled)" "$(current_rotation)" "$("$WIFI_CLIENT" ssid)"
}

# What a user would lose in a reinstall, and nothing else (Reflash#175): the
# printer's configuration (printer.cfg, the UI's, KlipperScreen's, LED effects,
# firmware options), Moonraker's database (history, the UI's own settings) and
# OctoPrint's settings. Not gcodes, logs or timelapses - large, and not
# configuration. Relative to the root, as tar stores them.
BACKUP_PATHS=(
    home/printer/printer_data/config
    home/printer/printer_data/database
    home/printer/.octoprint/config.yaml
    home/printer/.octoprint/users.yaml
    home/printer/.octoprint/data
)
BACKUP_EXCLUDES=(--exclude='*.log' --exclude='*.log.*' --exclude=home/printer/.octoprint/data/timelapse)

# Where the backup came from, as the archive's first entry. Always there, so a
# system with none of the files above - barebone - still makes a valid backup
# rather than an empty archive tar refuses to write (#136).
MANIFEST=rebuild-backup.manifest

version_of() {
    git -C "$R/$1" describe --tags --always 2>/dev/null || true
}

manifest() {
    printf 'format=1\n'
    printf 'created=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'rebuild_version=%s\n' "$(cat "$R/etc/rebuild-version" 2>/dev/null)"
    printf 'hostname=%s\n' "$(cat "$R/etc/hostname" 2>/dev/null)"
    printf 'board_revision=%s\n' "${REFLASH_REVISION:-}"
    printf 'board_serial=%s\n' "${REFLASH_SERIAL:-}"
    printf 'reflash_version=%s\n' "${REFLASH_VERSION:-}"
    printf 'klipper_version=%s\n' "$(version_of home/printer/klipper)"
    printf 'moonraker_version=%s\n' "$(version_of home/printer/moonraker)"
    printf 'paths=%s\n' "$*"
}

backup() {
    local p have=() t
    for p in "${BACKUP_PATHS[@]}"; do
        [ -e "$R/$p" ] && have+=("$p")
    done
    echo "backing up: ${have[*]:-only the manifest - this system has none of the files}" >&2
    t=$(mktemp -d)
    trap 'rm -rf "$t"' RETURN
    manifest "${have[@]}" > "$t/$MANIFEST"
    # Ownership by name, so a restore onto a newer image gives the files to
    # that image's printer user whatever its number.
    # -C only with files after it: a trailing one is an error to tar.
    tar -czf - "${BACKUP_EXCLUDES[@]}" -C "$t" "$MANIFEST" ${have[@]+-C "$R/" "${have[@]}"}
}

# Only the paths above come back, whatever the archive holds: it is a file a
# user carried around on a USB drive, and must not be able to write anywhere
# else in the system. GNU tar already strips leading / and refuses "..".
restore() {
    local t p n=0
    t=$(mktemp -d)
    trap 'rm -rf "$t"' RETURN
    tar -C "$t" -xzf - --no-same-permissions --same-owner 2>&1 | sed 's/^/tar: /' >&2 || true
    for p in "${BACKUP_PATHS[@]}"; do
        [ -e "$t/$p" ] || continue
        mkdir -p "$R/$(dirname "$p")"
        rm -rf "${R:?}/$p.restore-old"
        [ ! -e "$R/$p" ] || mv "$R/$p" "$R/$p.restore-old"
        cp -a "$t/$p" "$R/$p"
        rm -rf "${R:?}/$p.restore-old"
        echo "restored $p" >&2
        n=$((n + 1))
    done
    # Only the manifest is a valid backup too - one made on barebone, say - and
    # there is simply nothing to put back. Neither manifest nor files is not a
    # backup of ours at all.
    if [ "$n" -eq 0 ]; then
        [ -f "$t/$MANIFEST" ] || { echo "ERROR: this is not a Rebuild backup: no manifest and none of this system's files" >&2; exit 1; }
        echo "nothing to restore: the backup holds none of this system's files" >&2
    fi
}

case ${1:-} in
    prepare) prepare ;;
    configure) configure ;;
    settings) settings ;;
    backup) backup ;;
    restore) restore ;;
    *) echo "ERROR: action '${1:-}' is not supported by this image" >&2; exit 3 ;;
esac
