#!/bin/bash
# NetworkManager dispatcher: keep replies from the Wi-Fi address on Wi-Fi.
#
# A board with Ethernet AND a Wi-Fi dongle usually gets both addresses from the
# same DHCP server, on one subnet. Linux then picks the egress by route metric,
# and NetworkManager gives Ethernet the lower one, so every reply to traffic
# addressed to the WI-FI address leaves over the CABLE:
#
#   $ ip route get 192.168.32.125 from 192.168.32.173
#   192.168.32.125 from 192.168.32.173 dev end0        <-- Ethernet
#
# The board answers, so ping works and the address looks healthy. TCP is what
# suffers: the station never transmits on the air, and the path drops packets
# in bursts lasting minutes. Measured on the CI rig, 2026-09-16: 4 of 11
# wifi-login checks failed with "0/3 logins" while ping stayed at 4ms
# throughout, and the board's own stack showed 659 retransmits in 9993 segments
# (6.6%). Only the two dual-homed boards ever failed; the Wi-Fi-only board and
# the Ethernet-only boards never did.
#
# A policy rule fixes it: traffic sourced from the Wi-Fi address looks up a
# table whose routes go out the Wi-Fi device, so the path is symmetric.
#
# Done from a dispatcher rather than in the Client profile because the address
# is from DHCP: NetworkManager's ipv4.routing-rules needs the source written
# into the profile, which is not known until the lease arrives. This runs on
# every up and lease change, so it follows the address.
#
# Nothing here calls nmcli, and that is deliberate. Dispatcher scripts run
# synchronously while NetworkManager waits for them, so a script that asks NM a
# question through nmcli can deadlock against the daemon that is blocked on it.
# Everything needed is already in the environment NM provides (IP4_ADDRESS_0,
# IP4_GATEWAY) or in sysfs.
IFACE=$1
ACTION=$2
TABLE=100

[ -n "$IFACE" ] || exit 0
# Wireless or not, asked of the kernel rather than of NetworkManager.
[ -e "/sys/class/net/$IFACE/phy80211" ] || exit 0

rules_flush() {
    # Delete by selector, repeatedly: a rule can be left behind by a lease that
    # changed address, and `ip rule del` removes one match at a time.
    #
    # BOUNDED on purpose. NetworkManager runs dispatcher scripts synchronously
    # and waits for them, so an unbounded `while ip rule del ...` here is a way
    # to hang the daemon if the delete ever keeps reporting success. Ten is far
    # more rules than this table can accumulate - one per lease, cleared on
    # every down - and stopping early is harmless where hanging NM is not.
    local i
    for i in $(seq 10); do
        ip rule del table "$TABLE" 2>/dev/null || break
    done
    ip route flush table "$TABLE" 2>/dev/null || true
}

case "$ACTION" in
    up | dhcp4-change)
        # IP4_ADDRESS_0 is "<addr>/<prefix> <gateway>", set by NM for this
        # action. Falling back to the kernel covers a dispatcher invocation
        # that arrives without it.
        addr=${IP4_ADDRESS_0%% *}
        [ -n "$addr" ] || addr=$(ip -4 -o addr show dev "$IFACE" | awk '{print $4; exit}')
        [ -n "$addr" ] || exit 0
        ip=${addr%%/*}
        # Only when something else already carries a default route, which is
        # the dual-homed case this exists for. On a Wi-Fi-only board the main
        # table is already correct and a second copy of it buys nothing.
        other=$(ip -4 route show default | grep -v "dev $IFACE" | head -1)
        [ -n "$other" ] || exit 0

        gw=${IP4_GATEWAY:-$(ip -4 route show default dev "$IFACE" | awk '{print $3; exit}')}
        net=$(ip -4 route show dev "$IFACE" scope link | awk '{print $1; exit}')
        rules_flush
        [ -n "$net" ] && ip route add "$net" dev "$IFACE" src "$ip" table "$TABLE"
        [ -n "$gw" ] && ip route add default via "$gw" dev "$IFACE" table "$TABLE"
        ip rule add from "$ip" lookup "$TABLE"
        ;;
    down)
        rules_flush
        ;;
esac
exit 0
