#!/bin/sh
set -e

# Before this package existed, the image build copied these files in by hand.
# On a board upgraded in place they are still there, and each one beats the
# packaged copy: /usr/local/bin comes first in PATH, and a unit, drop-in or
# udev rule in /etc overrides the one in /usr/lib - the NetworkManager
# dispatcher script would even run twice. Move them aside, once, on the first
# install. Kept rather than deleted, in case a board had local edits.
LEGACY=/var/backups/rebuild-legacy

set_aside() {
    [ -e "$1" ] && [ ! -L "$1" ] || return 0
    mkdir -p "$LEGACY$(dirname "$1")"
    mv "$1" "$LEGACY$1"
}

# Old paths stay valid: units and scripts that came with the image still
# name /usr/local/bin.
link_old_path() {
    set_aside "/usr/local/bin/$1"
    [ -e "/usr/local/bin/$1" ] || ln -s "/usr/bin/$2" "/usr/local/bin/$1"
}

# Enable-links left pointing at a unit file that was just moved.
drop_dangling_links() {
    for l in /etc/systemd/system/*.wants/"$1" /etc/systemd/system/*.requires/"$1"; do
        [ -L "$l" ] && [ ! -e "$l" ] && rm -f "$l"
    done
    return 0
}

if [ "$1" = configure ] && [ -z "$2" ]; then
    for t in autohotspot get-recore-config get-recore-revision get-serial-number \
             set-recore-revision update-recore-revision; do
        link_old_path "$t" "$t"
    done
    link_old_path usb-gadget-init.sh usb-gadget-init

    for u in autohotspot.service usb-gadget-setup.service; do
        set_aside "/etc/systemd/system/$u"
        drop_dangling_links "$u"
    done
    set_aside /etc/systemd/system/serial-getty@ttyGS0.service.d/gadget.conf
    set_aside /etc/systemd/system/serial-getty@ttyGS0.service.d/nolock.conf
    rmdir /etc/systemd/system/serial-getty@ttyGS0.service.d 2>/dev/null || true
    set_aside /etc/udev/rules.d/99-recore-otg.rules
    set_aside /etc/NetworkManager/dispatcher.d/90-wifi-source-routing
fi

# dpkg.cfg.d/rebuild-firmware keeps dpkg from writing these again; clear
# what is already there. armbian-firmware is installed before this package.
if [ "$1" = configure ]; then
    rm -rf /lib/firmware/qcom /usr/lib/firmware/qcom
fi

# Boards set up before set-recore-revision wrote fdtfile= select their tree
# with a symlink the next linux-dtb upgrade will overwrite. Move them over
# while the symlink still names the revision; if an upgrade already replaced
# it, ask the eMMC. Only on a running board - not in the image build chroot;
# Reflash writes the line when it flashes an image.
#
# Also on the /boot trigger (rebuild-recore.triggers), because installing
# this package is not enough: an image flashed by a Reflash older than the
# fdtfile= change gets neither the line nor a postinst run on the board, and
# its first DTB upgrade then boots the generic Recore-all tree - seen on an A8
# taking a pin release. The trigger runs in the same transaction as the DTB
# upgrade, before any reboot.
if { [ "$1" = configure ] || [ "$1" = triggered ]; } &&
   [ -d /run/systemd/system ] && [ -f /boot/armbianEnv.txt ] &&
   ! grep -q '^fdtfile=' /boot/armbianEnv.txt; then
    rev=$(readlink /boot/dtb/allwinner/sun50i-a64-recore.dtb 2>/dev/null |
          sed -n 's/^sun50i-a64-recore-\(a[0-9]\)\.dtb$/\1/p')
    if [ -z "$rev" ] && [ -b /dev/mmcblk2boot0 ]; then
        rev=$(get-recore-revision 2>/dev/null) || rev=
    fi
    if [ -n "$rev" ]; then
        set-recore-revision "$rev" || true
    fi
fi

# Device tree overlays (#111), on every configure so an upgrade brings the
# new ones. In the image build too: that /boot is the image's. They take
# effect on the next boot.
if [ "$1" = configure ]; then
    /usr/lib/rebuild/boot-overlays install || true
fi

# Panic, lockup and SysRq settings (#107) now, not at the next boot: a crash
# before then should already reboot the board.
if [ "$1" = configure ] && [ -d /run/systemd/system ]; then
    /usr/lib/systemd/systemd-sysctl /usr/lib/sysctl.d/60-rebuild-recovery.conf || true
fi

if [ "$1" = configure ] && [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    udevadm control --reload || true
fi

#DEBHELPER#

exit 0
