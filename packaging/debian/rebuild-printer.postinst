#!/bin/sh
set -e

# See rebuild-recore.postinst: files the image build used to copy in by hand
# would override the packaged ones, so the first install moves them aside.
LEGACY=/var/backups/rebuild-legacy

set_aside() {
    [ -e "$1" ] && [ ! -L "$1" ] || return 0
    mkdir -p "$LEGACY$(dirname "$1")"
    mv "$1" "$LEGACY$1"
}

link_old_path() {
    set_aside "/usr/local/bin/$1"
    [ -e "/usr/local/bin/$1" ] || ln -s "/usr/bin/$1" "/usr/local/bin/$1"
}

drop_dangling_links() {
    for l in /etc/systemd/system/*.wants/"$1" /etc/systemd/system/*.requires/"$1"; do
        [ -L "$l" ] && [ ! -e "$l" ] && rm -f "$l"
    done
    return 0
}

if [ "$1" = configure ] && [ -z "$2" ]; then
    # klipper.service, written by the image build, runs these by their old path.
    for t in auto-disable-ssh is-ssh-enabled set-ssh-access rebuild-first-run \
             flash-stm32 flash-rp2040 flash-ar100.py set-ar100-clock.py; do
        link_old_path "$t"
    done

    for u in auto-disable-ssh.service auto-disable-ssh.timer rebuild-first-run.service; do
        set_aside "/etc/systemd/system/$u"
        drop_dangling_links "$u"
    done
    set_aside /etc/systemd/system/armbian-firstrun.service.d/oneshot.conf
    rmdir /etc/systemd/system/armbian-firstrun.service.d 2>/dev/null || true
    set_aside /etc/systemd/system/plymouth-quit.service.d/retain-splash.conf
    rmdir /etc/systemd/system/plymouth-quit.service.d 2>/dev/null || true
    set_aside /etc/udev/rules.d/55-rp2040-bootloader.rules
    set_aside /etc/systemd/system.conf.d/10-watchdog.conf
    set_aside /etc/systemd/resolved.conf.d/no-dnssec.conf

    # Settings that set-ssh-access rewrites: state, not a conffile, so it is
    # created once and never touched by an upgrade.
    if [ ! -e /etc/rebuild-settings ]; then
        install -m 600 /usr/share/rebuild/rebuild-settings.default /etc/rebuild-settings
    fi

    # Only on the first install, so an upgrade never undoes a user's choice
    # of theme. The initramfs is rebuilt by the update-initramfs trigger.
    if command -v plymouth-set-default-theme >/dev/null; then
        plymouth-set-default-theme recore
    fi
fi

# dpkg.cfg.d/rebuild-arm-toolchain keeps dpkg from writing these again;
# clear what is already there, on boards that got the toolchain first.
if [ "$1" = configure ]; then
    for d in /usr/lib/gcc/arm-none-eabi/*/ /usr/lib/arm-none-eabi/newlib/; do
        [ -d "$d" ] || continue
        rm -rf "$d/arm"
        for v in v7 v7+fp v7-a v7-a+fp v7-a+simd v7ve+simd v7-r+fp.sp v8-a v8-a+simd; do
            rm -rf "$d/thumb/$v"
        done
    done
fi

# Apply on package upgrades of an existing native-Weston image too. Do not
# convert X11 installations or restart the display from a maintainer script.
if [ "$1" = configure ] && [ -x /usr/bin/weston ] && \
   [ -f /etc/systemd/system/KlipperScreen.service.d/wayland.conf ] && \
   grep -q 'GDK_BACKEND=wayland' /etc/systemd/system/KlipperScreen.service.d/wayland.conf && \
   id printer >/dev/null 2>&1; then
    sh /usr/lib/rebuild/configure-weston-session
fi

# Every configure, not just the first: boards from images that installed
# OctoPrint's plugins as root need it once, and it is a no-op after that.
if [ "$1" = configure ]; then
    /usr/lib/rebuild/octoprint-venv-owner || true
fi

if [ "$1" = configure ] && [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    udevadm control --reload || true
fi

#DEBHELPER#

exit 0
