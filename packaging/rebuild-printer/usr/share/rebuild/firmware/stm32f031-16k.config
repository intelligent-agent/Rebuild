# Rebuild stock config for the STM32 on Recore A3-A6: an STM32F031x4, with
# 16 KB of flash (its flash size register says so; the A7/A8 part says 32).
#
# On these boards the STM32 drives the heater and fan outputs and reads the
# thermistors, the supply voltage and the current - GPIO and ADC. Everything
# else is off, which builds to about 11 KB on Klipper v0.13.0-786. Until this
# config, the build was 22.7 KB: its =n lines named options Klipper had since
# split up, so they did nothing, and the image ran in flash the part is not
# specified for.
#
# Switch a feature back on in printer_data/config/firmware/stm32.config;
# rebuild-firmware refuses a build that does not fit 16 KB.
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32F031=y
CONFIG_STM32_FLASH_START_0000=y
CONFIG_STM32_CLOCK_REF_INTERNAL=y
CONFIG_STM32_SERIAL_USART2_ALT_PA15_PA14=y
CONFIG_WANT_ADC=y
CONFIG_WANT_I2C=n
CONFIG_WANT_BUTTONS=n
CONFIG_WANT_TMCUART=n
CONFIG_WANT_NEOPIXEL=n
CONFIG_WANT_PULSE_COUNTER=n
CONFIG_WANT_ST7920=n
CONFIG_WANT_HD44780=n
CONFIG_WANT_LIS2DW=n
CONFIG_WANT_BMI160=n
CONFIG_WANT_MPU9250=n
CONFIG_WANT_ICM20948=n
CONFIG_WANT_HX71X=n
CONFIG_WANT_CS1237=n
CONFIG_WANT_TRIGGER_ANALOG=n
CONFIG_WANT_STEPPER_OPTIMIZED_BOTH_EDGE=n
