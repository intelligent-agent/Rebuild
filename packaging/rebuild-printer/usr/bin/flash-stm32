#!/bin/bash

set -e


FLASH_DEVICE=/dev/ttyS2
FIRMWARE=${REBUILD_FIRMWARE_DIR:-/opt/firmware}

# What was last written to the STM32: the build's variant and its sha256.
# rebuild-first-run runs at install time under Reflash and again on the first
# boot (#130); whichever comes second finds the chip already has this build and
# leaves it alone, without so much as a trip into its bootloader. A rebuilt
# firmware (rebuild-firmware build) has a different sha and is flashed. FORCE=1
# flashes regardless.
MARKER=$FIRMWARE/stm32.flashed
if [ -z "${FORCE:-}" ] && read -r was_variant was_sha 2>/dev/null < "$MARKER" &&
   [ -f "$FIRMWARE/$was_variant.bin" ] &&
   [ "$(sha256sum < "$FIRMWARE/$was_variant.bin" | cut -d' ' -f1)" = "$was_sha" ]; then
    echo "flash-stm32: already has $was_variant (sha256 ${was_sha:0:12}) - nothing to do"
    exit 0
fi

# Klipper owns the STM32's serial line, so it is stopped while the chip is
# flashed. Not under Reflash: that is a chroot with no systemd, and no Klipper
# running to stop.
klipper() {
    [ -n "${REFLASH_INTERFACE:-}" ] || systemctl "$1" klipper
}

klipper stop

# Release the boot pin however this script exits (#92).
#
# gpioset -z daemonises and holds GPIO 197 until something kills it. With the
# only pkill on the success path, any failure in between - a bad stm32flash, a
# missing binary, the get-recore-revision above - leaked a daemon that outlived
# the script, reparented to init, and kept the line claimed. Every later attempt
# then died at the FIRST step with
#
#   gpioset: unable to request lines on chip '/dev/gpiochip1': Device or resource busy
#
# so rebuild-first-run's Restart=on-failure retried forever and the original
# error was permanently masked - observed at restart 98, ~16 minutes in, with
# the leaked gpioset still alive across every one of them.
#
# Matched on 'gpioset.*boot-pin', not the bare 'boot-pin' this used: -f matches
# the whole command line, so the looser pattern kills ANY process that merely
# mentions the string - a shell script, an editor, a tail on this file. Requiring
# it to be a gpioset keeps that from reaching something unrelated. Not an exact
# match, because gpioset rewrites its own argv: it is invoked with "197=1" below
# and shows up in ps as "197 1".
drop_boot_pin() { pkill -f 'gpioset.*boot-pin' 2>/dev/null || true; }

# On the success path drop_boot_pin has already run, so this finds nothing and
# stays quiet; it only speaks up when it is actually cleaning up after a failure.
release_boot_pin() {
    if pkill -f 'gpioset.*boot-pin' 2>/dev/null; then
        echo "flash-stm32: released a leaked boot-pin hold on exit" >&2
    fi
}
trap release_boot_pin EXIT

# Set boot-pin high while flashing
gpioset -z -C "boot-pin" -c 1 197=1
# Set reset-pin 196 low, then high after 10 ms
gpioset -t 10ms,0 -c 1 196=0
# Which STM32F031 this is, from the chip itself: its flash size register
# (0x1FFFF7CC, in KB) says 16 on the x4 part (Recore A3-A6) and 32 on the x6
# (A7/A8). The device ID cannot tell them apart. The image carries a build for
# each (#106); flash the one made for this chip and keep only that.
FLASH_KB=$(stm32flash -r /tmp/stm32-flash-size -S 0x1FFFF7CC:2 ${FLASH_DEVICE} >/dev/null 2>&1 &&
           od -An -tu2 /tmp/stm32-flash-size | tr -d ' ' || true)
rm -f /tmp/stm32-flash-size
case "$FLASH_KB" in
    16|32) ;;
    *)
        # Unreadable: fall back on the revision, which matches every board
        # measured so far.
        case $(get-recore-revision 2>/dev/null) in a7|a8) FLASH_KB=32 ;; *) FLASH_KB=16 ;; esac
        echo "flash-stm32: could not read the flash size; assuming ${FLASH_KB} KB from the revision" ;;
esac
VARIANT=stm32f031-${FLASH_KB}k
STM32_BINARY=$FIRMWARE/$VARIANT.bin
echo "flash-stm32: ${FLASH_KB} KB part - $VARIANT"
echo "$FLASH_KB" > $FIRMWARE/stm32.flash-size

leave_bootloader() {
    drop_boot_pin
    gpioset -t 10ms,0 -c 1 196=0
    gpioget -c 1 -b pull-up 196
    klipper restart
}
if [ ! -f "$STM32_BINARY" ]; then
    echo "flash-stm32: no $STM32_BINARY - not flashing" >&2
    leave_bootloader; exit 1
fi
if [ "$(stat -c %s "$STM32_BINARY")" -gt $((FLASH_KB * 1024)) ]; then
    echo "flash-stm32: $STM32_BINARY is larger than the chip's ${FLASH_KB} KB - not flashing" >&2
    leave_bootloader; exit 1
fi

stm32flash -w ${STM32_BINARY} -v -g 0 ${FLASH_DEVICE}
echo "$VARIANT $(sha256sum < "$STM32_BINARY" | cut -d' ' -f1)" > "$MARKER"

# The other chip's build, and the names from before #106, are not for this
# board.
OTHER=stm32f031-$([ "$FLASH_KB" = 16 ] && echo 32 || echo 16)k
rm -f $FIRMWARE/$OTHER.bin $FIRMWARE/$OTHER.config $FIRMWARE/$OTHER.klipper-version $FIRMWARE/$OTHER.size \
      $FIRMWARE/stm32.bin $FIRMWARE/stm32.config $FIRMWARE/stm32-32KB.bin $FIRMWARE/stm32-32KB.config
# Set boot-pin low
drop_boot_pin
# 196 needs to be pull-up so the STM32 can use reset
gpioget -c 1 -b pull-up 196

klipper restart
