#!/bin/sh
# Keep the stock KlipperScreen launcher, but let systemd own its children.
set -eu

printer_uid=$(id -u printer)
dropins=/etc/systemd/system/KlipperScreen.service.d
mkdir -p "$dropins" /var/lib/systemd/linger

# Preserve /run/user/<uid> after the last login session ends. Writing the
# standard linger marker also works during image construction without logind.
if [ ! -e /var/lib/systemd/linger/printer ]; then
    install -m 644 /dev/null /var/lib/systemd/linger/printer
fi
if [ -d /run/systemd/system ]; then
    loginctl enable-linger printer
fi

cat > "$dropins/weston-containment.conf" <<EOF
# Generated by rebuild-printer for the installed printer user's UID.
[Unit]
Requires=user-runtime-dir@${printer_uid}.service
After=user-runtime-dir@${printer_uid}.service

[Service]
PAMName=
KillMode=control-group
EOF
