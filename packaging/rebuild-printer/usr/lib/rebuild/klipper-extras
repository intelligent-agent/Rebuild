#!/bin/bash
# Link Rebuild's own Klipper modules into Klipper's tree when the printer's
# config uses them (#116). Run before every Klipper start (klipper.service.d).
#
# Klipper only loads modules from klippy/extras, inside its own checkout. The
# modules live in rebuild-printer instead, so a package can fix them, and a
# Klipper update or reinstall cannot lose them: this puts a link back each
# time. Untracked links leave the checkout as Moonraker needs it.
#
# Only modules a config section names are linked - [recore_thermistor ...],
# [tmc2209_a5 stepper_x] - and what those import, so boards that do not use them (everything but
# the A5) see nothing extra in Klipper. A real file of the same name is the
# user's and is left alone.
EXTRAS=${KLIPPER_EXTRAS_SRC:-/usr/share/rebuild/klipper/extras}
TARGET=${KLIPPER:-/home/printer/klipper}/klippy/extras
CONFIG=${PRINTER_DATA:-/home/printer/printer_data}/config

[ -d "$TARGET" ] || exit 0

# Moonraker's update page lists untracked source files in Klipper's checkout
# ("Repo has untracked source files"), and our links are not the user's
# changes. So each one is listed in the checkout's own ignore file, which is
# not part of the repository and survives updates; Moonraker's
# `git status --porcelain` then leaves it out. (Klipper still calls itself
# -dirty: its own check counts ignored files too - see rebuild_firmware.py.)
# Rewritten in place, never replaced, so the file keeps its owner.
EXCLUDE=${KLIPPER:-/home/printer/klipper}/.git/info/exclude
exclude() {    # NAME add|remove
    local line="/klippy/extras/$1.py" rest
    [ -d "$(dirname "$(dirname "$EXCLUDE")")" ] || return 0
    if [ "$2" = add ]; then
        mkdir -p "$(dirname "$EXCLUDE")"
        grep -qxF "$line" "$EXCLUDE" 2>/dev/null || echo "$line" >>"$EXCLUDE"
    elif grep -qxF "$line" "$EXCLUDE" 2>/dev/null; then
        rest=$(grep -vxF "$line" "$EXCLUDE")
        printf '%s\n' "$rest" >"$EXCLUDE"
    fi
}

# What the config names, plus whatever of ours those import: tmc2209_a5 does
# `from . import tmc2130_a5`, and without the link Klipper stops with
# "cannot import name". Repeat until nothing is added.
declare -A want=()
for src in "$EXTRAS"/*.py; do
    name=$(basename "$src" .py)
    grep -rqsE "^\[$name[] ]" "$CONFIG" --include='*.cfg' && want[$name]=1
done
added=1
while [ -n "$added" ]; do
    added=""
    for name in "${!want[@]}"; do
        for dep in $(sed -n 's/^from \. import //p' "$EXTRAS/$name.py" | tr ',' ' '); do
            if [ -f "$EXTRAS/$dep.py" ] && [ -z "${want[$dep]:-}" ]; then
                want[$dep]=1; added=1
            fi
        done
    done
done

for src in "$EXTRAS"/*.py; do
    name=$(basename "$src" .py)
    dst=$TARGET/$name.py
    if [ -n "${want[$name]:-}" ]; then
        if [ -L "$dst" ] || [ ! -e "$dst" ]; then
            ln -sfn "$src" "$dst"
            exclude "$name" add
        fi
    elif [ "$(readlink "$dst" 2>/dev/null)" = "$src" ]; then
        rm -f "$dst"
        exclude "$name" remove
    fi
done
exit 0
