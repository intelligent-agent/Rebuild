#!/bin/bash
# Optional software: Klipper modules a person can ask for (Reflash#198, #205).
# Installed the way anyone installs them - a git clone, linked into Klipper's
# tree, and registered with Moonraker's update manager - so they update like
# any other. That needs the internet, which this checks first and says so when
# there is none: nothing is half installed.
#
#   software list            the names, one per line (none without Klipper)
#   software info NAME       one line for people
#   software status NAME     on or off
#   software install NAME
#   software remove NAME     takes the link out; the clone stays
#
# Runs in Reflash's chroot as well as on a running system. A module that is
# already there, however it got there, counts as installed and is left alone.
set -euo pipefail

R="${REFLASH_TEST_ROOT:-}"
PRINTER_HOME="$R/home/printer"
KLIPPER="$PRINTER_HOME/klipper"
TARGET="$KLIPPER/klippy/extras"
EXCLUDE="$KLIPPER/.git/info/exclude"
MOONRAKER_CONF="$PRINTER_HOME/printer_data/config/moonraker.conf"
# How to act as the printer user; the tests have no such user.
AS_PRINTER=${REBUILD_AS_PRINTER-runuser -u printer --}

die() { echo "ERROR: $*" >&2; exit 1; }

info_of() {
    case $1 in
        led_effect) echo "LED effects: animated effects for addressable LEDs (led_effect, by Julian Schill)" ;;
        *) return 1 ;;
    esac
}
origin_of() {
    case $1 in
        led_effect) echo "https://github.com/julianschill/klipper-led_effect.git" ;;
    esac
}
# The file in the clone that Klipper loads.
module_of() {
    case $1 in
        led_effect) echo "src/led_effect.py" ;;
    esac
}

known() { info_of "$1" > /dev/null || die "'$1' is not optional software Rebuild knows"; }

# Like klipper-extras: Moonraker's update page lists untracked files in the
# checkout, and this link is not the user's change.
exclude() {
    local line="/klippy/extras/$1.py" rest
    [ -d "$KLIPPER/.git" ] || return 0
    if [ "$2" = add ]; then
        mkdir -p "$(dirname "$EXCLUDE")"
        grep -qxF "$line" "$EXCLUDE" 2> /dev/null || echo "$line" >> "$EXCLUDE"
    elif grep -qxF "$line" "$EXCLUDE" 2> /dev/null; then
        rest=$(grep -vxF "$line" "$EXCLUDE")
        printf '%s\n' "$rest" > "$EXCLUDE"
    fi
}

# Installed means Klipper can load it: the file is there and resolves. A link
# left by an older image to a copy that image shipped is dangling, and is not.
installed() { [ -e "$TARGET/$1.py" ]; }

case ${1:-} in
    list)
        [ -d "$TARGET" ] || exit 0
        echo led_effect
        ;;
    info) info_of "${2:-}" ;;
    status)
        known "${2:-}"
        if installed "$2"; then echo on; else echo off; fi
        ;;
    install)
        known "${2:-}"
        name=$2
        [ -d "$TARGET" ] || die "there is no Klipper on this system to put $name into"
        if installed "$name"; then
            echo "$name is already installed"
            exit 0
        fi
        command -v git > /dev/null || die "git is not on this system, and $name is installed with it"
        origin=$(origin_of "$name")
        repo="$PRINTER_HOME/klipper-$name"
        # Before anything is written: no connection, no change.
        if ! timeout 25 git ls-remote --exit-code "$origin" HEAD > /dev/null 2>&1; then
            die "$name is installed from GitHub and there is no connection to it: connect the board to the internet and try again"
        fi
        if [ ! -d "$repo" ]; then
            $AS_PRINTER git clone -q --depth 1 "$origin" "$repo" || { rm -rf "$repo"; die "could not clone $origin"; }
        fi
        [ -f "$repo/$(module_of "$name")" ] || die "$repo has no $(module_of "$name")"
        rm -f "$TARGET/$name.py"
        # Relative, so it resolves the same in the chroot and on the running system.
        $AS_PRINTER ln -s "$(realpath -m --relative-to="$TARGET" "$repo/$(module_of "$name")")" "$TARGET/$name.py"
        exclude "$name" add
        # Moonraker's update manager, once.
        if [ -f "$MOONRAKER_CONF" ] && ! grep -q "^\[update_manager $name\]" "$MOONRAKER_CONF"; then
            printf '\n[update_manager %s]\ntype: git_repo\npath: ~/klipper-%s\norigin: %s\nis_system_service: False\n' "$name" "$name" "$origin" >> "$MOONRAKER_CONF"
        fi
        echo "$name installed"
        ;;
    remove)
        known "${2:-}"
        if [ -L "$TARGET/$2.py" ] || [ -e "$TARGET/$2.py" ]; then
            rm -f "$TARGET/$2.py"
            exclude "$2" remove
            echo "$2 removed"
        else
            echo "$2 is not installed"
        fi
        ;;
    *) die "usage: software list | info NAME | status NAME | install NAME | remove NAME" ;;
esac
